{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "HomeTruth design tokens. W3C Design Tokens Community Group (DTCG) format. Primitive tokens hold raw values; semantic tokens reference primitives by intent. Components should consume semantic tokens only.",
  "color": {
    "$type": "color",
    "primitive": {
      "$description": "Raw brand and neutral values. Do not reference these directly in components.",
      "orange": { "$value": "#E8651A", "$description": "Primary brand, CTAs, highlights" },
      "orange-light": { "$value": "#F28C4E", "$description": "Hover / light variant" },
      "cyan": { "$value": "#00B4D8", "$description": "Truth wordmark, links, primary accent" },
      "cyan-light": { "$value": "#48D1E8", "$description": "Hover / light variant" },
      "purple": { "$value": "#8B3FA0", "$description": "Secondary brand" },
      "purple-light": { "$value": "#A966BF", "$description": "Hover / light variant" },
      "green": { "$value": "#43B02A", "$description": "Success / positive accent" },
      "green-light": { "$value": "#6BC955", "$description": "Hover / light variant" },
      "black": { "$value": "#1A1A1A", "$description": "Text" },
      "dark": { "$value": "#0F1620", "$description": "Page / section background" },
      "mid-grey": { "$value": "#8C8C8C", "$description": "Secondary text" },
      "light-grey": { "$value": "#C4C4C4", "$description": "Borders, muted" },
      "white": { "$value": "#FFFFFF", "$description": "Body text on dark" }
    },
    "semantic": {
      "$description": "Intent-based aliases. Components reference these.",
      "action-primary": { "$value": "{color.primitive.orange}", "$description": "Primary buttons and CTAs" },
      "action-primary-hover": { "$value": "{color.primitive.orange-light}" },
      "accent": { "$value": "{color.primitive.cyan}", "$description": "Links and primary accent" },
      "accent-hover": { "$value": "{color.primitive.cyan-light}" },
      "secondary": { "$value": "{color.primitive.purple}" },
      "success": { "$value": "{color.primitive.green}" },
      "text-default": { "$value": "{color.primitive.black}" },
      "text-muted": { "$value": "{color.primitive.mid-grey}" },
      "text-on-dark": { "$value": "{color.primitive.white}" },
      "surface-default": { "$value": "{color.primitive.white}" },
      "surface-dark": { "$value": "{color.primitive.dark}" },
      "border-default": { "$value": "{color.primitive.light-grey}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": {
        "$value": ["Gill Sans", "Gill Sans MT", "-apple-system", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "Primary typeface for all HomeTruth surfaces"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "8px base spacing scale",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "24": { "$value": "96px" }
  },
  "icon": {
    "size": {
      "$type": "dimension",
      "$description": "Icon sizes anchored to the 8px grid",
      "sm": { "$value": "16px" },
      "md": { "$value": "24px" },
      "lg": { "$value": "32px" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "16px" },
    "full": { "$value": "9999px" }
  },
  "gradient": {
    "$type": "gradient",
    "brand-diagonal": {
      "$value": [
        { "color": "{color.primitive.orange}", "position": 0 },
        { "color": "{color.primitive.purple}", "position": 0.5 },
        { "color": "{color.primitive.cyan}", "position": 1 }
      ],
      "$description": "Signature brand gradient, 135deg. Use for top bar, underlines, gradient text."
    }
  }
}
